                  "status": {
                    "const": "unverified"
                  }
                }
              },
              "then": {
                "properties": {
                  "source": {
                    "const": "call"
                  }
                }
              }
            }
          ]
        },
        "purchaseInvoice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
