{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-chat-agent.example/record.schema.json",
  "title": "Device repair claim record",
  "description": "The single sanitized, structured record produced when a claim session reaches an end state (schemaVersion 1.0). Each revision is immutable; a later revision is a new record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "revision",
    "outcome",
    "outcomeReason",
    "previousRevision",
    "fields",
    "missingRequired",
    "conflicts",
    "reviewFlags",
    "submitConfirmation",
    "engagement",
    "costUsd",
    "costBreakdownUsd",
    "actualSpendUsd",
    "createdAt",
    "endedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "outcomeReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "previousRevision": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "outcome"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "outcome": {
              "$ref": "#/$defs/outcome"
            }
          }
        }
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceType",
        "deviceModel",
        "problemDescription",
        "problemStartedAt",
        "urgency",
        "serialNumber",
        "purchaseInvoice",
        "serviceCentre",
        "email",
        "additionalPhotos",
        "additionalNotes"
      ],
      "properties": {
        "deviceType": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "collectedAt",
            "status"
          ],
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/deviceType"
                }
              ]
            },
            "source": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/source"
                }
              ]
            },
            "collectedAt": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/timestamp"
                }
              ]
            },
            "status": {
              "enum": [
                "valid",
                "invalid",
                "missing"
              ]
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/fieldStatusRules"
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "valid",
                      "unverified"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "$ref": "#/$defs/deviceType"
                  }
                }
              }
            }
          ]
        },
        "deviceModel": {
