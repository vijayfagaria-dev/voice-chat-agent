        "serialNumber": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "collectedAt",
            "status"
          ],
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/serialNumber"
                }
              ]
            },
            "source": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/source"
                }
              ]
            },
            "collectedAt": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/timestamp"
                }
              ]
            },
            "status": {
              "enum": [
                "valid",
                "invalid",
                "missing",
                "unverified"
              ]
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/fieldStatusRules"
