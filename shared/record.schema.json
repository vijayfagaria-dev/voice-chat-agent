            "collectedAt",
            "status"
          ],
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/purchaseInvoice"
                }
              ]
            },
            "source": {
              "anyOf": [
