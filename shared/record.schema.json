        },
        "serviceCentre": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "collectedAt",
            "status"
          ],
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
