{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["**", "!**/dist", "!**/node_modules"] },
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": { "enabled": true, "rules": { "preset": "recommended" } },
	"overrides": [
		{
			"includes": ["web/**"],
			"linter": {
				"rules": {
					"a11y": { "noSvgWithoutTitle": "off", "useSemanticElements": "off" },
					"correctness": { "useExhaustiveDependencies": "off" },
					"suspicious": { "noArrayIndexKey": "off", "useIterableCallbackReturn": "off" },
					"style": { "noDescendingSpecificity": "off" }
				}
			}
		}
	]
}
