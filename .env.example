# Copy to .env (gitignored) and fill in real values locally.
# In production these are set as host secrets (Render environment), never in the repo or the browser.
# Names only here. Never put a real value in this file.

# Speech-to-text and text-to-speech (Deepgram: STT + Aura TTS)
DEEPGRAM_API_KEY=

# LLM for the call agent (Groq free tier, OpenAI-compatible API)
GROQ_API_KEY=

# Backup LLM (Google AI Studio / Gemini API free tier). Optional.
GEMINI_API_KEY=

# Postgres (Neon free tier). Use the pooled connection string with sslmode=require.
DATABASE_URL=

# --- App settings and app secrets (P1-T02) ---
# Generate each secret with: openssl rand -base64 32

# Exact browser origin of the page (scheme + host, no path). Must be https in production.
PUBLIC_ORIGIN=http://localhost:8080

# Signs expiring file URLs (at least 32 characters).
FILE_URL_SECRET=

# Authenticates record webhook deliveries to the stub receiver (at least 32 characters).
HOOK_SECRET=

# Test-only HTTP API. Keep false unless testing; TEST_API_TOKEN (at least 24 characters) is required when true.
ALLOW_TEST_API=false
TEST_API_TOKEN=

# Optional: where finished records are POSTed (http or https URL). Unset = this server's own stub receiver.
# The request carries X-Hook-Secret (HOOK_SECRET) and an Idempotency-Key header.
RECORD_WEBHOOK_URL=

# An idle session with every required field valid but unconfirmed is completed (true, the default) or left partial (false).
AUTO_COMPLETE_ON_IDLE=

# Optional: lets the owner bypass the daily quota guard (at least 24 characters).
QUOTA_OVERRIDE_TOKEN=

# Optional: reverse-proxy hops whose X-Forwarded-For entry is trusted as the client IP (0 = socket address).
# Check it on the host: the client IP in the request logs must be your own public IP.
TRUST_PROXY_HOPS=0

# Optional: new sessions one client IP may create per hour.
NEW_SESSIONS_PER_IP_PER_HOUR=20

# Optional, with defaults: NODE_ENV=development, HOST=0.0.0.0, PORT=8080, LOG_LEVEL=info

# Optional: seconds without a call or user activity before the idle timer fires (default 900 = 15 min; 60 or more).
IDLE_TIMEOUT_SECONDS=900

# Optional: a session closes this many seconds after its last activity (default 604800 = 7 days).
SESSION_LIFETIME_SECONDS=604800

# Optional: the most all stored uploads may add up to, in bytes (default 629145600 = 600 MB; Neon free is 1 GB).
UPLOAD_BUDGET_BYTES=629145600

# Optional: how long a signed file link in a record stays valid, in seconds (default 2592000 = 30 days).
FILE_URL_TTL_SECONDS=2592000

# Optional: the call agent's LLM (D06): the Groq model first, then the fallbacks in order (groq:<model> or gemini:<model>).
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODELS=groq:openai/gpt-oss-120b,gemini:gemini-flash-lite-latest

# Optional: the Aura-2 voice (D05), calls one instance runs at once (free-tier limits), and the longest call in seconds.
TTS_VOICE=aura-2-thalia-en
MAX_CONCURRENT_CALLS=1
MAX_CALL_SECONDS=600
